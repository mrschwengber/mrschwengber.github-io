Input
Alvo_Final(3.5);
Stop_Final(1.0);
Spread_E(0);
Spread_S(40);
HoraInicio(941);
HoraFim(1201);
HoraFechamento(1700);
Trava(1);
CAP(2000);
Stop_CAP(900);
IFR_C(77);
IFR_V(28);
sGain(25);
Stop_Min(240);


var

entrada, stop, alvo, protecao,entrada_v, stop_v, alvo_v, protecao_v, break_c, break_v, stop_b, stop_s, break_stop_s, break_stop_b: float;
posicao : boolean;
fBoolUp : float;
fBoolDown : float;
file_compra, file_venda : boolean;


begin
  //indicadores
  fboolup := BollingerBands(2.00,20,0)|0|;
  fbooldown := BollingerBands(2.00,20,0)|1|;
  
  //sinais de entrada
  file_compra := (posicao = false) e (Close[0] > fboolup[0]) and (RSI(9,0)[0] > IFR_C) and (close[0] > mediaexp(210,close)[0]) e 
  (close[0] > open[0]) e (time >= HoraInicio) e (time < HoraFim);
  file_venda := (posicao = false) e (Close[0] < fbooldown[0]) and (RSI(9,0)[0] < IFR_V) and (close[0] < mediaexp(210,close)[0]) e 
  (time >= HoraInicio) e (time < HoraFim) e (close[0] < open[0]); 
  
  //execução de entrada
  se (file_compra) e (posicao = false) e ((close[0] - low[0] - 10) > Stop_Min) entao
  begin 
      entrada := close[0];
      stop := low[0] - 10;
      stop_b := entrada - stop;
      Break_Stop_B := entrada - Stop_cap;
      alvo := entrada + (entrada - stop) * Alvo_final ;
      break_c := entrada + sGain;
      protecao := entrada + (entrada - stop);
      posicao := true;
      BuyLimit(entrada-Spread_E);
  end;
  se (file_venda) e (not HasPosition) e ((high[0] + 10 - close[0]) > Stop_Min) entao
  begin 
    entrada_v := close[0];
    stop_v := high[0] + 10;
    stop_s := stop_v - entrada_v;
    Break_stop_s := entrada_V + Stop_Cap;
    alvo_v := entrada_v - stop_s * Alvo_final ;
    protecao_v := entrada_v - stop_s;
    break_v := entrada_v - sGain;
    posicao := true;
    SellShortLimit(entrada_v+Spread_E);
    end; 

      //breakeven
  se (IsBought) and (Trava = 1) and (high[0] >= protecao) and (HasPendingOrders) then
  begin
  Stop := Break_C;
  Break_Stop_B := Break_C;
  end;

  se (IsSold) and (Trava = 1) and (low[0] <= Protecao_V) and (HasPendingOrders) then
  begin
  Stop_V := Break_V;
  Break_stop_s := Break_V;
  end;  
      
  //execução de saída
  se (isbought) then
  begin
    se (((Alvo-Entrada)+Spread_S) < CAP) entao
      SellToCoverLimit(Alvo+Spread_S);   //Alvo
    se (Stop_B < Stop_CAP) entao
      SellToCoverStop(Stop, Stop-100);   //Stop abaixo do Stop Cap
    se (Stop_B > Stop_CAP) entao
      SellToCoverStop(Break_Stop_B, Stop-100); //Stop acima do Stop Cap
    se (((Alvo-Entrada)+Spread_S) > CAP) entao
      SellToCoverLimit(Entrada+CAP);              //Saída no CAP
  end;
  
  se (isBought) e (Trava = 1) e (high[0] >= protecao) e (close[0] < Break_C) then
  begin
  ClosePosition;
  end;
   
  se (isSold) then
  begin
    se (((Entrada_V-Alvo_v)-Spread_S) < CAP) entao
      BuyToCoverLimit(Alvo_V-Spread_S);
    se (Stop_S < Stop_CAP) entao
      BuyToCoverStop(Stop_V,Stop_V+100);
    se (((Entrada_v-Alvo_v)-Spread_S) > CAP) entao
      BuyToCoverLimit(Entrada_V-CAP);
    se (Stop_S > Stop_CAP) entao
      BuyToCoverStop(Break_Stop_S,Stop_V+100);
  end;
  
  se (isSold) e (Trava = 1) e (low[0] <= Protecao_V) e (close[0] > Break_V) then
  begin
  ClosePosition;
  end; 

//fechamento
  se (time >= HoraFechamento) then 
  begin
  ClosePosition;
  posicao := false;
  end;

  se (time <= HoraInicio) then
  begin
  posicao := false;
  end;

end;
